# Token de acceso al dashboard/agente (scripts/agent.py)
# Protege UI y control (/processes, /launch/*, /stop). /health queda abierto.
# Login en navegador: HTTP Basic Auth (usuario cualquiera, contraseña = AGENT_TOKEN)
# API: header X-DiLoCo-Token o ?token=
# Genera uno fuerte: openssl rand -hex 32
AGENT_TOKEN=change-me-agent-token
